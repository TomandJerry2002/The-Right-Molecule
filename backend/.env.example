# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_DEBUG=1
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API from the browser (your Vite dev server / live site)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production only: the https origin(s) of the admin, e.g. https://api.therightmolecule.com
CSRF_TRUSTED_ORIGINS=

# Cashfree — Dashboard → Developers → API Keys. Use the Test keys with sandbox.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01

# Where Cashfree returns the customer after payment. {order_id} is filled in automatically.
CHECKOUT_RETURN_URL=http://localhost:5173/checkout.html?order_id={order_id}
# Public https URL of this backend (production). Enables the per-order webhook.
BACKEND_PUBLIC_URL=

# Store
SHIPPING_FEE_INR=0
MAX_QTY_PER_ITEM=10

# Email (SMTP). Leave EMAIL_HOST empty in development to print emails to the console.
# Works with any provider, e.g. Zoho Mail (smtp.zoho.in), Google Workspace (smtp.gmail.com
# with an app password), Brevo (smtp-relay.brevo.com), Resend (smtp.resend.com).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=The Right Molecule <orders@therightmolecule.com>
SUPPORT_EMAIL=hello@therightmolecule.com
# Comma-separated addresses that get a "new order" email for every paid order
ORDER_NOTIFY_EMAILS=
